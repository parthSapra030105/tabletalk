# Written by scripts/setup_db.py. Two connections on purpose:
# the app connection loads data; the read-only one runs every model-written query.
DATABASE_URL=postgresql://tabletalk_app:<generated>@localhost:5432/tabletalk
READONLY_DATABASE_URL=postgresql://tabletalk_reader:<generated>@localhost:5432/tabletalk

# Any OpenAI-compatible endpoint. Leave LLM_BASE_URL empty to use OpenAI itself.
LLM_BASE_URL=
LLM_API_KEY=<your key>
LLM_MODEL=<model name>
# Optional: used once when LLM_MODEL is overloaded or times out.
LLM_FALLBACK_MODEL=
